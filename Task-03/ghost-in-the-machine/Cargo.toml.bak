[package]
name = "navnet-intro"
version = "0.1.0"
edition = "2021"
description = "Earliest recovered Navigation Network introduction service."
authors = ["Navigation Network Engineering Division <infra@navnet.local>"]
license = "Apache-2.0"
repository = "https://internal.navnet.local/repos/navnet-intro"
readme = "README.md"

[dependencies]
anyhow = "1.0"
env_logger = "0.10"
log = "0.4"
navnet-core = { path = "navnet-core" }

[workspace]
members = ["navnet-core"]
